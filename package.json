{
  "name": "gridflow",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @gridflow/web",
    "dev:api": "npm run dev -w @gridflow/api",
    "dev:agent": "npm run dev -w @gridflow/agent",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
