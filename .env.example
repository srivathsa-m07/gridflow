# ------------------------------------------------------------------------------
# GRIDFLOW Central Configuration Template
# Rename this file to '.env' at the root of the project to configure Docker Compose.
# ------------------------------------------------------------------------------

# MongoDB Atlas connection string (Required for telemetry gateway logs)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gridflow?retryWrites=true&w=majority

# Gemini API Key (Optional, for Incident summaries)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Port bindings on the host machine
API_PORT=3001
WEB_PORT=3000

# Base URL used by the frontend console in the browser to reach the Telemetry Gateway
VITE_API_URL=http://localhost:3001

# ID assigned to the Docker-Compose telemetry agent instance
AGENT_ID=gridflow-agent-docker

# Runtime Node environment configuration
NODE_ENV=production
